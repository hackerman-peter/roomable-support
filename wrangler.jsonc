{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomable-support-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "routes": [
    {
      "pattern": "roomable.deploid.now",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./.build/worker-site",
    "binding": "ASSETS",
    "run_worker_first": ["/condition", "/condition/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
