{
  "name": "roomable-support-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "zsh Verification/build-worker-assets.zsh",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "npm run build && vitest run",
    "verify": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "dev": "npm run build && wrangler dev --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.129.0"
  }
}
